@page "/admin-page"
@inject NavigationManager _nav
@inject AuthState _auth
@inject Supabase.Client _supabase
@using SAMS.Models
@inject IJSRuntime _js
<PageTitle>Students</PageTitle>

<div class="content-body">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3>Admins</h3>
        <button @onclick="ToggleAddAdmin" class="btn btn-primary">Add New Admin</button>
    </div>

    <div class="p-3 bg-white border border-1 mb-3 @(isAddAdmin ? "" : "d-none")">
        <h5>Add New Admin</h5>
        <div class="add-input">
            <div class="p-0">
                <p class="m-0 p-0 fw-bold">Name</p>
                <input type="text" class="form-control"/>
            </div>

            <div class="p-0">
                <p class="m-0 p-0 fw-bold">Email</p>
                <input type="text" class="form-control" />
            </div>
        </div>
        <div class="add-input mt-2">
            <div class="p-0">
                <p class="m-0 p-0 fw-bold">Password</p>
                <input type="text" class="form-control" />
            </div>
        </div>

        <div class="d-flex flex-row gap-2 mt-3">
            <button class="btn btn-primary">Add Admin</button>
            <button @onclick="CloseAddAdmin" class="btn btn-dark">Cancel</button>
        </div>
    </div>

    <div class="position-relative d-flex flex-grow-0 mb-3">
        <i class="bi bi-search position-absolute c2" style="top: .5rem; left: .75rem; font-size: 18px;"></i>
        <input @bind="@searchString" @bind:event="oninput" type="text" class="form-control border search" placeholder="Search admin..." />
    </div>

    <table class="table border border-1 p-3 align-middle">
        <thead>
            <tr>
                <td>Name</td>
                <td>Email</td>
                <td>Role</td>
                <td>Date Added</td>
                <td>Status</td>
                <td class="@(_auth.accessLevel == "superadmin" ? "" : "d-none")">Action</td>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in _filteredTeacherList)
            {
                <tr>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.accessLevel</td>
                    <td>@item.CreatedAt</td>
                    <td>
                        @if (item.IsApproved)
                        {
                            <p class="m-0 p-0">Approved</p>
                        }
                        else
                        {
                            <button @onclick="() => ApproveAdmin(item.Id)" class="btn btn-success">Approve</button>
                        }
                    </td>
                    <td class="@(_auth.accessLevel == "superadmin" ? "" : "d-none")">
                        <ThemeSwitch Value="item.isActive" Label="@(item.isActive ? "Active" : "Disabled")" OnBeforeChange="@((bool val) => ToggleActivity(item.Id, val))"/>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code{
    bool isAddAdmin = false;
    List<Teacher> _teacherList = new();
    IEnumerable<Teacher> _filteredTeacherList => _teacherList.Where(u => string.IsNullOrWhiteSpace(searchString) || u.FullName.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                                                u.Email.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                                                u.CreatedAt.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                                                u.accessLevel.Contains(searchString, StringComparison.OrdinalIgnoreCase));
    string searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAdmin();
    }

    //get the admin/teachers from database
    private async Task LoadAdmin()
    {
        var response = await _supabase.From<Teacher>().Get();

        _teacherList = response.Models;
    }

    //Toggle Add Student
    private void ToggleAddAdmin()
    {
        isAddAdmin = true;
    }

    //Close Add Student Modal
    private void CloseAddAdmin()
    {
        isAddAdmin = false;
    }

    //Aproved admin
    private async Task ApproveAdmin(Guid guid)
    {
        bool confirm = await _js.InvokeAsync<bool>("confirm", "Are you sure you want to approve this admin?");

        if (!confirm) return;

        try
        {
            var result = await _supabase.From<Teacher>().Where(u => u.Id == guid).Set(x => x.IsApproved, true).Update();

            if (result.Models.Any())
            {
                await LoadAdmin();
                await _js.InvokeVoidAsync("alert", "Approved successfully");
            }
            else
            {
                await _js.InvokeVoidAsync("alert", "Update failed");
            }
        }
        catch (Exception ex)
        {
            await _js.InvokeVoidAsync("alert", ex.Message);
        }
    }

    //Toogle activity
    private async Task ToggleActivity(Guid id, bool e)
    {
        bool confirm = await _js.InvokeAsync<bool>("confirm", "Are you sure you want to save changes?");

        if (!confirm) return;

        try
        {
            var user = await _supabase.From<Teacher>().Where(u => u.Id == id).Set(a => a.isActive, e).Update();

            if (user.Models.Any())
            {
                await LoadAdmin();
                await _js.InvokeVoidAsync("alert", "Success!");
            }
            else
            {
                await _js.InvokeVoidAsync("alert", "Failed to update!");
            }
        }
        catch (Supabase.Gotrue.Exceptions.GotrueException ex2)
        {
            await _js.InvokeVoidAsync("alert", ex2.Message);
        }
        catch (Exception ex)
        {
            await _js.InvokeVoidAsync("alert", ex.Message);
        }
    }
}