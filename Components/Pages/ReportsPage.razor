@page "/reports-page"
@inject NavigationManager _nav
@inject Supabase.Client _supabase
@inject IJSRuntime _js
@inject AuthState _auth
<PageTitle>Reports Page</PageTitle>

<div class="content-body">
    <h3>Attendance Reports - @className</h3>
    <p class="@(isFetching ? "" : "d-none") fst-italic m-0 p-0">Fetching data...</p>

    <div class="attendance-report-container mt-2">
        <div class="daily-report">
            <div class="bg-primary p-3">
                <p class="text-white m-0 p-0">Daily Report - @dateNow.ToString("MMMM dd, yyyy dddd")</p>
            </div>
            <div class="daily-report-content p-3">
                <p style="font-size: smaller" class="m-0 p-0">Select Date</p>
                <div>
                    <input type="date" max="@DateTime.Now.ToString("yyyy-MM-dd")" @bind="dateNow" @bind:after="GetDailyReport" class="form-control mt-2" />
                </div>
                

                <div class="status-card mt-3">
                    <div class="d-flex flex-column align-items-center justify-content-center p-4 rounded rounded-2" style="background-color: rgba(232,243,238,100)">
                        <h3 class="m-0 p-0 text-success">@dailyReport.present</h3>
                        <p class="m-0 p-0">Present</p>
                    </div>
                    <div class="d-flex flex-column align-items-center justify-content-center p-4 rounded rounded-2" style="background-color: rgba(251,234,236,100)">
                        <h3 class="m-0 p-0 text-danger">@dailyReport.absent</h3>
                        <p class="m-0 p-0">Absent</p>
                    </div>
                    <div class="d-flex flex-column align-items-center justify-content-center p-4 rounded rounded-2" style="background-color: rgba(255,249,230,100)">
                        <h3 class="m-0 p-0" style="color: #FFC107;">@dailyReport.late</h3>
                        <p class="m-0 p-0">Late</p>
                    </div>
                </div>

                <hr class="mt-3"/>

                <div class="d-flex justify-content-between mt-3 align-items-center">
                    <p style="font-size: smaller" class="fw-bold m-0 p-0">Total Students:</p>
                    <p style="font-size: smaller" class="m-0 p-0">@dailyReport.totalStudents</p>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <p style="font-size: smaller" class="fw-bold m-0 p-0">Attendance Rate:</p>
                    <p style="font-size: smaller" class="m-0 p-0">@dailyReport.attendanceRate%</p>
                </div>
            </div>
        </div>

        <div class="daily-report">
            <div class="bg-info p-3">
                <p class="text-white m-0 p-0">Weekly Report(Last 7 Days)</p>
            </div>
            <div class="daily-report-content p-3">
                <div class="status-card">
                    <div class="d-flex flex-column align-items-center justify-content-center p-4 rounded rounded-2" style="background-color: rgba(232,243,238,100)">
                        <h3 class="m-0 p-0 text-success">@weeklyReport.present</h3>
                        <p class="m-0 p-0">Present</p>
                    </div>
                    <div class="d-flex flex-column align-items-center justify-content-center p-4 rounded rounded-2" style="background-color: rgba(251,234,236,100)">
                        <h3 class="m-0 p-0 text-danger">@weeklyReport.absent</h3>
                        <p class="m-0 p-0">Absent</p>
                    </div>
                    <div class="d-flex flex-column align-items-center justify-content-center p-4 rounded rounded-2" style="background-color: rgba(255,249,230,100)">
                        <h3 class="m-0 p-0" style="color: #FFC107;">@weeklyReport.late</h3>
                        <p class="m-0 p-0">Late</p>
                    </div>
                </div>

                <hr class="mt-3" />

                <div class="d-flex justify-content-between mt-3 align-items-center">
                    <p style="font-size: smaller" class="fw-bold m-0 p-0">Total Records:</p>
                    <p style="font-size: smaller" class="m-0 p-0">@weeklyReport.totalEntries</p>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <p style="font-size: smaller" class="fw-bold m-0 p-0">Average Attendance:</p>
                    <p style="font-size: smaller" class="m-0 p-0">@weeklyReport.attendanceRate%</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code{
    DateTime dateNow = DateTime.SpecifyKind(DateTime.Now.Date, DateTimeKind.Utc);
    string className = string.Empty;
    Guid classId = Guid.Empty;
    List<Class> _classList = new();
    DailyReport dailyReport = new();
    WeeklyReport weeklyReport = new();
    bool isFetching = false;

    protected override async Task OnInitializedAsync()
    {
        await GetClass();
        if (classId != Guid.Empty)
        {
            await GetDailyReport();
            await GetWeeklyReport();
        }
    }

    private async Task GetClass()
    {
        try
        {
            isFetching = true;
            var result = await _supabase.From<Class>().Where(x => x.TeacherId == _auth.id).Get();
            if (result.Models.Any())
            {
                className = result.Models.First().SectionName;
                classId = result.Models.First().Id;
            }
            isFetching = false;
            // else
            // {
            //     await _js.InvokeVoidAsync("alert", "You don't have a class yet.");
            // }
        }
        catch (Exception ex)
        {
            await _js.InvokeVoidAsync("alert", ex.Message);
        }
    }

    //Method for daily reports
    private async Task GetDailyReport()
    {
        var queryDate = dateNow.Date;

        var result = await _supabase
            .From<Attendance>()
            .Where(a =>
                a.ClassId == classId &&
                a.AttendanceDate == queryDate)
            .Get();

        dailyReport = new();

        dailyReport.present = result.Models.Count(a => a.Status == "present");
        dailyReport.absent = result.Models.Count(a => a.Status == "absent");
        dailyReport.late = result.Models.Count(a => a.Status == "late");

        dailyReport.totalStudents =
            dailyReport.present +
            dailyReport.absent +
            dailyReport.late;

        dailyReport.attendanceRate =
            dailyReport.totalStudents > 0
                ? (dailyReport.present * 100) / dailyReport.totalStudents
                : 0;
    }


    //Get Weekly Report
    private async Task GetWeeklyReport()
    {
        try
        {
            isFetching = true;
            // Ensure UTC for Supabase compatibility
            var endDateUtc = DateTime.SpecifyKind(DateTime.Now.Date, DateTimeKind.Utc);
            var startDateUtc = endDateUtc.AddDays(-7);

            // 2. Fetch records within the range
            // var result = await _supabase.From<Attendance>().Where(u => u.ClassId == classId && u.AttendanceDate >= startDateUtc && u.AttendanceDate <= endDateUtc).Get();

            // 1. Prepare your dates as ISO strings to avoid type issues
            string startStr = startDateUtc.ToString("yyyy-MM-dd");
            string endStr = endDateUtc.ToString("yyyy-MM-dd");

            // 2. Chain the filters instead of putting them all in one Where()
            var result2 = await _supabase.From<Attendance>()
                .Where(u => u.ClassId == classId)
                .Filter(u => u.AttendanceDate, Supabase.Postgrest.Constants.Operator.GreaterThanOrEqual, startStr)
                .Filter(u => u.AttendanceDate, Supabase.Postgrest.Constants.Operator.LessThanOrEqual, endStr)
                .Get();
            if (result2.Models.Any())
            {
                weeklyReport = new(); // Assuming you have a similar object for weekly
                weeklyReport.present = result2.Models.Count(u => u.Status == "present");
                weeklyReport.absent = result2.Models.Count(u => u.Status == "absent");
                weeklyReport.late = result2.Models.Count(u => u.Status == "late");
                weeklyReport.totalEntries = result2.Models.Count;

                // Avoid division by zero
                if (weeklyReport.totalEntries > 0)
                {
                    weeklyReport.attendanceRate = (weeklyReport.present * 100) / weeklyReport.totalEntries;
                }
            }
            // else
            // {
            //     weeklyReport = new();
            //     await _js.InvokeVoidAsync("alert", "No records found for this week.");
            // }
            isFetching = false;
        }
        catch (Exception ex)
        {
            await _js.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }

    private class DailyReport
    {
        public int present { get; set; } = 0;
        public int absent { get; set; } = 0;
        public int late { get; set; } = 0;
        public int totalStudents { get; set; } = 0;
        public int attendanceRate { get; set; } = 0;
    }

    private class WeeklyReport
    {
        public int present { get; set; } = 0;
        public int absent { get; set; } = 0;
        public int late { get; set; } = 0;
        public int totalEntries { get; set; } = 0;
        public int attendanceRate { get; set; } = 0;
    }
}