    private void MarkStatus(Guid Id, string status)
    {
        var stud = _attendanceViewModel.FirstOrDefault(u => u.id == Id);
        if (stud != null)
        {
            stud.status = status;
        }
    }
    private async Task SaveAttendance()
    {
        try
        {
            bool confirm = await _js.InvokeAsync<bool>("confirm", "Confirm save attendance");
            if (!confirm) return;

            // Check if anyone is still "Not Marked"
            if (_attendanceViewModel.Any(u => u.status == "Not Marked"))
            {
                await _js.InvokeVoidAsync("alert", "Cannot proceed. Some students are unmarked.");
                return;
            }

            isSaving = true;
            var dateToAdd = DateTime.SpecifyKind(selectedDate.Date, DateTimeKind.Utc);

            foreach (var item in _attendanceViewModel)
            {
                if (item.attId == Guid.Empty)
                {
                    // NEW STUDENT: This student has no record for this date yet
                    await _supabase.From<Attendance>().Insert(new Attendance
                    {
                        AttendanceDate = dateToAdd,
                        ClassId = item.classId,
                        CreatedAt = DateTime.UtcNow,
                        Status = item.status.ToLower(),
                        StudentId = item.id,
                        StudentNo = item.studentNo
                    });
                }
                else
                {
                    // EXISTING RECORD: Update the existing status using the attId
                    await _supabase.From<Attendance>()
                                   .Where(u => u.Id == item.attId)
                                   .Set(x => x.Status, item.status.ToLower())
                                   .Update();
                }
            }

            await _js.InvokeVoidAsync("alert", "Attendance processed successfully");
            isSaving = false;

            // Refresh the list to get the new attIds from the database
            await LoadAttendance();
        }
        catch (Exception ex)
        {
            await _js.InvokeVoidAsync("alert", $"Error: {ex.Message}");
            isSaving = false;
        }
    }

