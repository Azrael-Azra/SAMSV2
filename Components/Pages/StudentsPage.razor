@page "/students-page"
@inject NavigationManager _nav
@inject Supabase.Client _supabase
@inject IJSRuntime _js

<PageTitle>Students</PageTitle>

<div class="content-body">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3>Students</h3>
        <button @onclick="ToggleAddStudent" class="btn btn-primary">Add New Student</button>
    </div>

    <div class="p-3 bg-white border border-1 mb-3 @(isAddStudent ? "" : "d-none")">
        <h5>Add New Student</h5>

        <div class="add-input">
            <div>
                <p class="fw-bold">Name</p>
                <input @bind="_student.FullName" class="form-control" />
            </div>

            <div>
                <p class="fw-bold">Email</p>
                <input @bind="_student.Email" class="form-control" />
            </div>
        </div>

        <div class="add-input mt-2">
            <div>
                <p class="fw-bold">Section</p>
                <select @bind="_student.ClassId" class="form-select">
                    <option value="@Guid.Empty">-- Select Section --</option>
                    @foreach (var item in _sectionList)
                    {
                        <option value="@item.Id">@item.SectionName</option>
                    }
                </select>
            </div>

            <div>
                <p class="fw-bold">Password</p>
                <input @bind="password" type="password" class="form-control" />
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button @onclick="AddStudent" class="btn btn-primary">Add Student</button>
            <button @onclick="CloseAddStudent" class="btn btn-dark">Cancel</button>
        </div>
    </div>

    <input @bind="searchString" @bind:event="oninput"
           class="form-control mb-3"
           placeholder="Search student..." />

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Student No</th>
                <th>Name</th>
                <th>Email</th>
                <th>Class</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in _filteredstudent)
            {
                <tr>
                    <td>@item.studentNo</td>
                    <td>@item.fullname</td>
                    <td>@item.email</td>
                    <td>@item.sectionName</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {

    List<Class> _sectionList = new();
    List<Student> _studentList = new();
    List<StudentClassVM> _studentClassList = new();

    Student _student = new();
    string password = string.Empty;
    string searchString = string.Empty;
    bool isAddStudent = false;

    IEnumerable<StudentClassVM> _filteredstudent =>
        _studentClassList.Where(s =>
            string.IsNullOrWhiteSpace(searchString) ||
            s.studentNo.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
            s.fullname.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
            s.email.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
            s.sectionName.Contains(searchString, StringComparison.OrdinalIgnoreCase)
        );

    protected override async Task OnInitializedAsync()
    {
        await LoadStudents();
    }

    private async Task LoadStudents()
    {
        try
        {
            var students = await _supabase.From<Student>().Get();
            var classes = await _supabase.From<Class>().Get();

            _studentList = students.Models ?? new();
            _sectionList = classes.Models ?? new();

            _studentClassList =
                (from s in _studentList
                 join c in _sectionList on s.ClassId equals c.Id
                 select new StudentClassVM
                     {
                         id = s.Id,
                         classId = c.Id,
                         studentNo = s.StudentNo,
                         fullname = s.FullName,
                         email = s.Email,
                         sectionName = c.SectionName
                     }).ToList();
        }
        catch
        {
            await _js.InvokeVoidAsync("alert", "Failed to load students");
        }
    }

    private void ToggleAddStudent() => isAddStudent = true;

    private void CloseAddStudent()
    {
        isAddStudent = false;
        _student = new();
        password = string.Empty;
    }

    private async Task AddStudent()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(_student.FullName) ||
                string.IsNullOrWhiteSpace(_student.Email) ||
                string.IsNullOrWhiteSpace(password))
            {
                await _js.InvokeVoidAsync("alert", "Fields cannot be empty");
                return;
            }

            if (_student.ClassId == Guid.Empty)
            {
                await _js.InvokeVoidAsync("alert", "Select a section");
                return;
            }

            var auth = await _supabase.Auth.SignUp(_student.Email, password);
            if (auth.User == null) return;

            var latest = await _supabase
                .From<Student>()
                .Order("created_at", Supabase.Postgrest.Constants.Ordering.Descending)
                .Limit(1)
                .Get();

            string studentNo = "STU00000001";

            if (latest.Models.Any())
            {
                var last = latest.Models.First().StudentNo.Replace("STU", "");
                studentNo = $"STU{(int.Parse(last) + 1):D8}";
            }

            await _supabase.From<Student>().Insert(new Student
                {
                    StudentNo = studentNo,
                    FullName = _student.FullName,
                    Email = _student.Email,
                    ClassId = _student.ClassId,
                    AuthUserId = Guid.Parse(auth.User.Id),
                    CreatedAt = DateTime.UtcNow
                });

            CloseAddStudent();
            await LoadStudents();
        }
        catch (Exception ex)
        {
            await _js.InvokeVoidAsync("alert", ex.Message);
        }
    }

    public class StudentClassVM
    {
        public Guid id { get; set; }
        public Guid classId { get; set; }
        public string studentNo { get; set; } = string.Empty;
        public string fullname { get; set; }
        public string email { get; set; }
        public string sectionName { get; set; }
    }
}
